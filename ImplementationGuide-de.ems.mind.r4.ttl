       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "DIVI 7.1 Einsatzort / Location" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Vollständiges deutsches Location-Profil für den DIVI-Notfalleinsatzprotokoll-Einsatzort. Die MIND-Einsatzort-Ressource (LocationDeEmsMindR4) ist eine Constraint-Ableitung dieses Basisprofils." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
