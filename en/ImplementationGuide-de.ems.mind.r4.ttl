       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "DIVI 7.1 Einsatz / Encounter" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Vollständiges deutsches Encounter-Profil für das DIVI-Notfalleinsatzprotokoll (Einsatztechnische Daten). Die MIND-Einsatz-Ressource (EncounterDeEmsMindR4) ist eine Constraint-Ableitung dieses Basisprofils." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
